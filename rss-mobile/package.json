    "@mozilla/readability": "^0.6.0",
    "dompurify": "^3.4.2",
    "fast-xml-parser": "^5.8.0",
    "jeep-sqlite": "^2.8.0",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.6"
  },

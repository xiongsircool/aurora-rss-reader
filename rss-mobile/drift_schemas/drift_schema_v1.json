    {
      "name": "feeds",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feeds\" (\"id\" TEXT NOT NULL, \"url\" TEXT NOT NULL UNIQUE, \"title\" TEXT NOT NULL, \"custom_title\" TEXT NULL, \"site_url\" TEXT NULL, \"description\" TEXT NULL, \"group_name\" TEXT NOT NULL DEFAULT 'default', \"view_type\" TEXT NOT NULL DEFAULT 'articles', \"update_interval_minutes\" INTEGER NOT NULL DEFAULT 720, \"fetch_etag\" TEXT NULL, \"fetch_last_modified\" TEXT NULL, \"last_checked_at\" INTEGER NULL, \"last_error\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" TEXT NOT NULL, \"feed_id\" TEXT NOT NULL REFERENCES feeds (id) ON DELETE CASCADE, \"guid\" TEXT NOT NULL, \"title\" TEXT NULL, \"url\" TEXT NULL, \"author\" TEXT NULL, \"summary\" TEXT NULL, \"content\" TEXT NULL, \"categories_json\" TEXT NULL, \"published_at\" INTEGER NULL, \"inserted_at\" INTEGER NOT NULL, \"read_at\" INTEGER NULL, \"starred\" INTEGER NOT NULL DEFAULT 0 CHECK (\"starred\" IN (0, 1)), \"enclosure_url\" TEXT NULL, \"enclosure_type\" TEXT NULL, \"enclosure_length\" INTEGER NULL, \"duration_seconds\" INTEGER NULL, \"image_url\" TEXT NULL, \"doi\" TEXT NULL, \"pmid\" TEXT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"feed_id\", \"guid\"));"
        }
      ]
    },
    {
      "name": "summaries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"summaries\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NOT NULL REFERENCES entries (id) ON DELETE CASCADE, \"language\" TEXT NOT NULL, \"summary\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"entry_id\", \"language\"));"
        }
      ]
    },
    {
      "name": "translations",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"translations\" (\"id\" TEXT NOT NULL, \"entry_id\" TEXT NOT NULL REFERENCES entries (id) ON DELETE CASCADE, \"language\" TEXT NOT NULL, \"title\" TEXT NULL, \"summary\" TEXT NULL, \"content\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"entry_id\", \"language\"));"
        }
      ]
    },
    {
      "name": "user_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"language\" TEXT NOT NULL DEFAULT 'zh-CN', \"auto_refresh\" INTEGER NOT NULL DEFAULT 0 CHECK (\"auto_refresh\" IN (0, 1)), \"refresh_interval_minutes\" INTEGER NOT NULL DEFAULT 720, \"ai_base_url\" TEXT NOT NULL DEFAULT '', \"ai_model\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "user_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_tags\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, \"color\" TEXT NOT NULL DEFAULT '#3b82f6', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entry_tags",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entry_tags\" (\"entry_id\" TEXT NOT NULL REFERENCES entries (id) ON DELETE CASCADE, \"tag_id\" TEXT NOT NULL REFERENCES user_tags (id) ON DELETE CASCADE, \"is_manual\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_manual\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"entry_id\", \"tag_id\"));"
        }
      ]
    },
